# Public address. Use your domain for automatic HTTPS, for example article.example.com.
# For temporary IP-only HTTP testing, use :80 and set COOKIE_SECURE=false.
SITE_ADDRESS=article.example.com
PUBLIC_BASE_URL=https://article.example.com

# Single GHCR package holds both images; tags separate backend / frontend.
BACKEND_IMAGE=ghcr.io/comioko/article-pilot
FRONTEND_IMAGE=ghcr.io/comioko/article-pilot
IMAGE_TAG=latest

# Spring Boot server
SERVER_PORT=8567
COOKIE_SECURE=true

# Database (MySQL credentials injected from these names)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ArticlePilot
DB_USERNAME=articlepilot
DB_PASSWORD=replace-with-a-strong-database-password
DB_SSL=false
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Generate independent strong passwords with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# AI and image services
DASHSCOPE_API_KEY=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
PEXELS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-image-preview

# Stripe. Webhook endpoint: https://your-domain/api/webhook/stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Article agent tuning
ARTICLE_AGENT_ENABLED=true
ARTICLE_AGENT_MAX_ITERATIONS=10

# Knife4j/Swagger UI; keep disabled in production
API_DOCS_ENABLED=false

# JVM tuning
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0 -Djava.security.egd=file:/dev/./urandom
